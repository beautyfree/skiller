{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/v1/skills/:identifier*",
      "destination": "/api/v1/skill-snapshot?identifier=:identifier"
    }
  ]
}
