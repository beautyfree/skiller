{
  "name": "skiller-monorepo",
  "version": "0.3.4",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd=apps/desktop run dev",
    "dev:debug": "bun --cwd=apps/desktop run dev:debug",
    "build": "bun --cwd=apps/desktop run build",
    "preview": "bun --cwd=apps/desktop run preview",
    "typecheck": "bun --cwd=apps/desktop run typecheck && bun --cwd=apps/marketplace-proxy run typecheck",
    "test": "bun --cwd=apps/desktop run test && bun test apps/marketplace-proxy/src",
    "dist:mac": "bun --cwd=apps/desktop run dist:mac",
    "dist:win": "bun --cwd=apps/desktop run dist:win",
    "dist:linux": "bun --cwd=apps/desktop run dist:linux",
    "marketplace:dev": "bun --cwd=apps/marketplace-proxy run dev",
    "marketplace:build": "bun --cwd=apps/marketplace-proxy run build"
  },
  "license": "SUL-1.0"
}
